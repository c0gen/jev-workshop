{
  "name": "jev-playground",
  "version": "1.0.0",
  "description": "A personal Windows workspace for TypeSafe Jev experiments",
  "author": "Jev Playground",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:desktop": "npm run build && node scripts/desktop-test.mjs",
    "pack": "npm run build && electron-builder --dir --win --x64",
    "dist": "npm run build && electron-builder --win nsis --x64",
    "postinstall": "node -e \"const D=require('better-sqlite3');const d=new D(':memory:');d.close()\"",
    "format": "prettier --write src tests scripts *.ts *.json README.md",
    "format:check": "prettier --check src tests scripts *.ts *.json README.md"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "0.6.0",
    "better-sqlite3": "13.0.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/theme-one-dark": "6.1.3",
    "@radix-ui/react-dialog": "1.2.0",
    "@radix-ui/react-tabs": "1.1.22",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "codemirror": "6.0.2",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "lucide-react": "1.52.0",
    "playwright": "1.63.0",
    "prettier": "3.9.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "7.3.7",
    "vitest": "5.0.3"
  },
  "build": {
    "appId": "local.jev.playground",
    "productName": "Jev Playground",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json",
      "!node_modules/better-sqlite3/prebuilds/linux*.node",
      "!node_modules/better-sqlite3/prebuilds/darwin*.node",
      "!node_modules/better-sqlite3/prebuilds/win32-arm64.node"
    ],
    "asar": true,
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/better-sqlite3/prebuilds/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": true,
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "extraResources": [
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      }
    ]
  }
}
